# PHPStan + Larastan — análise estática do painel.
# Rodar: vendor/bin/phpstan analyse   (ou `make lint-php` na raiz)
# Erros pré-existentes vivem em phpstan-baseline.neon; regenerar com
#   vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
# só quando a dívida for reduzida, nunca para esconder erro novo.
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    tmpDir: storage/framework/cache/phpstan
    reportUnmatchedIgnoredErrors: false
