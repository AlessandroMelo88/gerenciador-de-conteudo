{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint resources/js",
        "lint:fix": "oxlint --fix resources/js",
        "format": "prettier --write resources/js resources/css vite.config.js",
        "format:check": "prettier --check resources/js resources/css vite.config.js",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:install": "playwright install --with-deps chromium"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^5.0.2",
        "concurrently": "^9.0.1",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.1",
        "oxlint": "^1.80.0",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vitest": "^5.0.2"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/geist": "^5.2.9",
        "@inertiajs/react": "^3.6.1",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.24.0",
        "radix-ui": "^1.6.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "recharts": "^3.8.0",
        "shadcn": "^4.13.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "ziggy-js": "^2.6.3",
        "zod": "^4.4.3"
    }
}
