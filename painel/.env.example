APP_NAME="Canal de Cortes"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

# Marca do painel (config/branding.php): canaldecortes | umbrella.
# BRAND_DOMAINS escolhe por host e vence APP_BRAND. Ex.: painel.umbrellasolutions.com.br=umbrella
APP_BRAND=canaldecortes
BRAND_DOMAINS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clips_automation
DB_USERNAME=clips_user
DB_PASSWORD=

# Exemplo de configuração caso opte por PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=clips_automation
# DB_USERNAME=clips_user
# DB_PASSWORD=secret
# DB_SSLMODE=prefer


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1

# Ponte HTTP interna painel -> clip-processor (Plan 08-07/08-08)
CLIP_PROCESSOR_INTERNAL_URL=http://clip-processor:8090
CLIP_PROCESSOR_INTERNAL_TOKEN=

# Path onde o painel le token-{slug}.json para calcular o badge OAuth (accessor
# DestinationChannel::oauth_status). So precisa ser sobrescrito se o volume
# ./canaldecortes/youtube nao estiver montado no path default abaixo.
CLIP_PROCESSOR_TOKEN_DIR=/var/www/html/painel/../youtube
BRANDING_DISK_ROOT=/var/www/html/branding
CLIPS_VIDEOS_DISK_ROOT=/var/www/html/videos

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALLOWED=
# URL pública configurada no setWebhook do Telegram.
TELEGRAM_WEBHOOK_URL=
# Secret configurado no setWebhook do Telegram; sem ele o webhook é rejeitado.
TELEGRAM_WEBHOOK_SECRET=

# Criado automaticamente pelo bootstrap-panel quando os dois valores existem.
PAINEL_OPERATOR_EMAIL=
PAINEL_OPERATOR_PASSWORD=

# Afiliados: token do worker local para POST/GET /api/offers (vazio = API desligada, 503)
AFFILIATE_API_TOKEN=

# Afiliados: divulgação no Telegram (offers:publish-telegram). nicho=chat, separado por vírgula.
# O bot precisa ser admin do canal. Vazio = nada é divulgado.
AFFILIATE_TELEGRAM_CHANNELS=
AFFILIATE_TELEGRAM_PER_RUN=3
