# Servidor (painel Laravel) que recebe as ofertas via POST /api/offers
AFFILIATE_API_URL=https://painel.exemplo.com.br
AFFILIATE_API_TOKEN=

# IA para copy (opcionais: sem chave, cai para o próximo provedor e por fim no template)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Mercado Livre (opcional; necessário se a busca anônima responder 401/403)
MERCADOLIVRE_ACCESS_TOKEN=

# Diretório de dados locais (default: affiliate-worker/data)
# AFFILIATE_DATA_DIR=
