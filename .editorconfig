# EditorConfig — https://editorconfig.org
# Vale para o repositório inteiro; painel/.editorconfig refina o Laravel.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab

[*.sql]
indent_size = 2
