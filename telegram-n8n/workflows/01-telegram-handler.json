    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parsear Comando').first().json.chatId }}",
        "text": "🤖 *Canal de Cortes Bot*\n\nComandos disponíveis:\n\n`/buscar <tema>` — Busca vídeos no YouTube sobre o tema\n`/trending` — Top 5 assuntos em alta no futebol BR\n`/fila` — Lista clipes prontos para upload\n`/status` — Métricas do pipeline\n`/canal <URL>` — Adiciona canal ao monitoramento\n`/ajuda` — Esta mensagem\n\n_Exemplos:_\n`/buscar Flamengo gol polêmico`\n`/buscar Neymar declaração`",
        "additionalFields": {
