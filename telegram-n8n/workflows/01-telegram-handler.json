        "chatId": "={{ $('Parsear Comando').first().json.chatId }}",
        "text": "Buscando tendências do futebol brasileiro...",
        "additionalFields": {}
      },
      "id": "ack-trending",
      "name": "ACK Trending",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [900, 320],
      "credentials": {
        "telegramApi": {
          "id": "telegram-canal-decortes",
          "name": "Telegram Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "operation": "query",
        "query": "SELECT gc.id, LEFT(gc.title, 60) AS titulo, gc.score, ROUND(gc.end_time - gc.start_time, 0) AS duracao_s, gc.created_at FROM generated_clips gc WHERE gc.status = 'pending' ORDER BY gc.score DESC, gc.created_at DESC LIMIT 10",
        "additionalFields": {}
      },
      "id": "query-fila",
      "name": "Consultar Fila",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [900, 500],
      "credentials": {
        "mySql": {
          "id": "mysql-canal-decortes",
          "name": "MySQL Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const clips = $input.all();\n\nif (!clips || clips.length === 0) {\n  return [{ json: { message: '📭 Nenhum clipe na fila.\\n\\nO pipeline pode estar processando ou nenhum vídeo novo foi encontrado.' } }];\n}\n\nlet msg = `📋 *Fila de Publicação* — ${clips.length} clipe(s)\\n\\n`;\n\nclips.forEach((c, i) => {\n  const d = c.json;\n  const duracao = d.duracao_s < 60 ? `${d.duracao_s}s ⚡` : `${Math.round(d.duracao_s/60)}min`;\n  msg += `*${i+1}.* [ID:${d.id}] Score:${d.score}/10\\n`;\n  msg += `   ${duracao} — ${d.titulo}\\n\\n`;\n});\n\nmsg += `Para publicar manualmente:\\n\\`./manual-workflow/mark-published.sh <ID> <YT_ID>\\``;\n\nreturn [{ json: { message: msg } }];"
      },
      "id": "format-fila",
      "name": "Formatar Fila",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 500]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parsear Comando').first().json.chatId }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-fila",
      "name": "Enviar Fila",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1300, 500],
      "credentials": {
        "telegramApi": {
          "id": "telegram-canal-decortes",
          "name": "Telegram Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "operation": "query",
        "query": "SELECT (SELECT COUNT(*) FROM generated_clips WHERE status = 'pending') AS clips_prontos, (SELECT COUNT(*) FROM generated_clips WHERE status = 'published' AND DATE(published_at) = CURDATE()) AS publicados_hoje, (SELECT COUNT(*) FROM generated_clips WHERE status = 'published') AS total_publicados, (SELECT COUNT(*) FROM source_videos WHERE status = 'pending') AS videos_pendentes, (SELECT COUNT(*) FROM source_videos WHERE status = 'downloaded') AS videos_baixados, (SELECT COUNT(*) FROM source_channels WHERE active = 1) AS canais_ativos",
        "additionalFields": {}
      },
      "id": "query-status",
      "name": "Consultar Status",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [900, 680],
      "credentials": {
        "mySql": {
          "id": "mysql-canal-decortes",
          "name": "MySQL Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst now = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nconst msg = `📊 *Status do Pipeline*\\n` +\n  `_${now} (BRT)_\\n\\n` +\n  `🎬 Clips prontos para upload: *${s.clips_prontos}*\\n` +\n  `✅ Publicados hoje: *${s.publicados_hoje}*\\n` +\n  `📺 Total publicados: *${s.total_publicados}*\\n\\n` +\n  `📥 Vídeos pendentes download: *${s.videos_pendentes}*\\n` +\n  `💾 Vídeos baixados (aguardando IA): *${s.videos_baixados}*\\n\\n` +\n  `📡 Canais monitorados: *${s.canais_ativos}*\\n\\n` +\n  `⏰ Próximo upload automático: 19h00 BRT`;\n\nreturn [{ json: { message: msg } }];"
      },
      "id": "format-status",
      "name": "Formatar Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 680]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parsear Comando').first().json.chatId }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
