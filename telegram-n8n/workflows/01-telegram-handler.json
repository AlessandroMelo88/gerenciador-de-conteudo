{
  "name": "01 — Telegram Handler (Canal de Cortes)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-canaldecortes",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst message = body.message;\n\nif (!message || !message.text) {\n  return [{ json: { skip: true } }];\n}\n\nconst text = message.text.trim();\nconst chatId = message.chat.id;\nconst parts = text.split(' ');\nconst command = parts[0].toLowerCase();\nconst args = parts.slice(1).join(' ');\n\nreturn [{\n  json: {\n    command,\n    args,\n    chatId,\n    messageId: message.message_id,\n    username: message.from?.username || 'usuario',\n    text\n  }\n}];"
      },
      "id": "parse-command",
      "name": "Parsear Comando",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.command }}",
              "operation": "equals",
              "value2": "/buscar"
            }
          ]
        }
      },
      "id": "route-buscar",
      "name": "É /buscar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 200]
    },
