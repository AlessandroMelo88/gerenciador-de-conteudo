{
  "name": "03 — Agente de Tendências Futebol BR (Canal de Cortes)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "cron-diario",
      "name": "Todo Dia 8h BRT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "notes": "Dispara automaticamente às 8h BRT. Ajuste o timezone nas configurações do N8N para America/Sao_Paulo"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "canaldecortes-trending",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trending",
      "name": "Webhook Manual (via /trending)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 480]
    },
    {
      "parameters": {
        "url": "https://trends.google.com/trends/trendingsearches/daily/rss?geo=BR",
        "options": {}
      },
      "id": "google-trends",
      "name": "Google Trends BR RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCuQ6rRHBPsK4t1hOlnpB-6Q",
        "options": {},
        "notes": "Feed RSS do SporTV — usado para cruzar com tendências"
      },
      "id": "rss-sportv",
      "name": "RSS SporTV (últimos vídeos)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 480]
    },
    {
      "parameters": {
        "jsCode": "// Parseia o XML do Google Trends manualmente\nconst trendsXml = $('Google Trends BR RSS').first().json.data || '';\nconst sportvXml = $('RSS SporTV (últimos vídeos)').first().json.data || '';\n\n// Extrai trending searches do Google Trends RSS\nconst trendMatches = trendsXml.matchAll(/<title><!\\[CDATA\\[(.+?)\\]\\]><\\/title>/g);\nconst allTrends = Array.from(trendMatches).map(m => m[1]).slice(1); // skip feed title\n\n// Filtra por termos de futebol\nconst futebolTermos = [\n  'futebol', 'gol', 'copa', 'brasileirão', 'libertadores', 'champions',\n  'flamengo', 'corinthians', 'palmeiras', 'são paulo', 'grêmio', 'internacional',\n  'atletico', 'cruzeiro', 'botafogo', 'vasco', 'santos', 'fluminense',\n  'neymar', 'vini', 'endrick', 'rodrygo', 'raphinha', 'seleção', 'cbf',\n  'arbitragem', 'var', 'pênalti', 'expulsão', 'técnico', 'transferência'\n];\n\nconst trendsFutebol = allTrends.filter(t =>\n  futebolTermos.some(termo => t.toLowerCase().includes(termo))\n);\n\n// Extrai títulos recentes do SporTV\nconst sportvMatches = sportvXml.matchAll(/<title><!\\[CDATA\\[(.+?)\\]\\]><\\/title>/g) ||\n  sportvXml.matchAll(/<title>(.+?)<\\/title>/g);\nconst sportvTitles = Array.from(sportvMatches).map(m => m[1]).slice(1, 6);\n\nconst today = new Date().toLocaleDateString('pt-BR', {\n  timeZone: 'America/Sao_Paulo',\n  weekday: 'long',\n  day: 'numeric',\n  month: 'long'\n});\n\nreturn [{\n  json: {\n    trendsFutebol: trendsFutebol.slice(0, 8),\n    sportvTitles,\n    today\n  }\n}];"
      },
      "id": "parse-trends",
      "name": "Parsear Tendências",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "claude-haiku-4-5",
          "max_tokens": 600,
          "messages": [
            {
              "role": "user",
              "content": "={{ 'Você é um especialista em conteúdo de futebol brasileiro para YouTube Shorts.\\n\\nHoje é ' + $json.today + '.\\n\\nTendências do Google Brasil relacionadas a futebol:\\n' + ($json.trendsFutebol.length > 0 ? $json.trendsFutebol.join(', ') : 'Nenhuma detectada') + '\\n\\nÚltimos vídeos do SporTV:\\n' + $json.sportvTitles.join('\\n') + '\\n\\nCom base nisso, liste os TOP 5 assuntos de futebol brasileiro que valem fazer um clipe hoje. Para cada um:\\n1. Nome do assunto/evento\\n2. Por que é viral agora (1 frase)\\n3. Sugestão de busca para encontrar o vídeo fonte\\n\\nSeja direto e prático. Responda em português.'}
            }
          ]
        },
        "options": {}
      },
      "id": "claude-analise",
      "name": "Claude — Análise de Tendências",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 380],
      "notes": "Requer ANTHROPIC_API_KEY como credencial HTTP Header Auth (chave 'x-api-key')"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rawData = $('Parsear Tendências').first().json;\n\nconst analysisText = response.content?.[0]?.text || 'Não foi possível gerar análise.';\nconst today = rawData.today;\n\nconst message = `🔥 *Tendências do Futebol BR — ${today}*\\n\\n` +\n  analysisText + '\\n\\n' +\n  `_Para buscar um vídeo: /buscar <termo>_`;\n\n// Extrai sugestões de busca do texto da IA\nconst suggestions = (analysisText.match(/\\/buscar [^\\n]+/g) || []).map(s => s.trim());\n\nreturn [{ json: { message, suggestions, today } }];"
      },
      "id": "format-trending",
      "name": "Formatar Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 380]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $vars.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram",
      "name": "Enviar para Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1400, 300],
      "credentials": {
        "telegramApi": {
          "id": "telegram-canal-decortes",
          "name": "Telegram Canal de Cortes"
        }
      },
      "notes": "Configure TELEGRAM_CHAT_ID em Variáveis do N8N (Settings > Variables)"
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Webhook Manual (via /trending)').first().json.chatId || $vars.TELEGRAM_CHAT_ID }}",
        "text": "={{ $('Formatar Resultado').first().json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram-manual",
      "name": "Resposta Telegram Manual",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1400, 480],
      "credentials": {
        "telegramApi": {
          "id": "telegram-canal-decortes",
          "name": "Telegram Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}"
      },
      "id": "webhook-response",
      "name": "Resposta Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1600, 480]
    }
  ],
  "connections": {
    "Todo Dia 8h BRT": {
      "main": [
        [
          { "node": "Google Trends BR RSS", "type": "main", "index": 0 },
          { "node": "RSS SporTV (últimos vídeos)", "type": "main", "index": 0 }
