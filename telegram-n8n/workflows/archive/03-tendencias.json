        [
          { "node": "Google Trends BR RSS", "type": "main", "index": 0 },
          { "node": "RSS SporTV (últimos vídeos)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Google Trends BR RSS": {
      "main": [
        [{ "node": "Parsear Tendências", "type": "main", "index": 0 }]
      ]
    },
    "RSS SporTV (últimos vídeos)": {
      "main": [
        [{ "node": "Parsear Tendências", "type": "main", "index": 0 }]
      ]
    },
    "Parsear Tendências": {
      "main": [
        [{ "node": "Claude — Análise de Tendências", "type": "main", "index": 0 }]
      ]
    },
    "Claude — Análise de Tendências": {
      "main": [
        [{ "node": "Formatar Resultado", "type": "main", "index": 0 }]
      ]
    },
    "Formatar Resultado": {
      "main": [
        [
          { "node": "Enviar para Telegram", "type": "main", "index": 0 },
          { "node": "Resposta Telegram Manual", "type": "main", "index": 0 }
        ]
      ]
    },
    "Resposta Telegram Manual": {
      "main": [
        [{ "node": "Resposta Webhook", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "meta": {
    "description": "Busca tendências do futebol BR via Google Trends + RSS e envia análise da IA para o Telegram todo dia às 8h."
  }
}
