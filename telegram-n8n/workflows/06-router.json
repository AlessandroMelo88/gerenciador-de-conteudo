    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT COUNT(*) FROM generated_clips WHERE status='pending') AS pending, (SELECT COUNT(*) FROM generated_clips WHERE status='approved') AS approved, (SELECT COUNT(*) FROM generated_clips WHERE status='published' AND DATE(published_at)=CURDATE()) AS published_today",
        "options": {}
      },
      "id": "status-query-stats",
      "name": "Status: Query Stats",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [920, 80],
      "credentials": {
        "mySql": {
          "id": "mysql-canal-decortes",
          "name": "MySQL Canal de Cortes"
        }
      }
