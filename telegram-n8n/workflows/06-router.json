    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, LEFT(COALESCE(title, '(sem título)'), 60) AS titulo, ROUND(COALESCE(end_time, 0) - COALESCE(start_time, 0)) AS duration_s FROM generated_clips WHERE status='pending' ORDER BY created_at ASC LIMIT 10",
        "options": {}
      },
      "id": "clipes-query",
      "name": "Clipes: Query Pending",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [920, 220],
      "credentials": {
        "mySql": {
          "id": "mysql-canal-decortes",
          "name": "MySQL Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Formata lista de clips pending recebida do MySQL.\nconst rows = $input.all().map(i => i.json);\nlet message;\nif (!rows || rows.length === 0) {\n  message = 'Nenhum clip pending.';\n} else {\n  const lines = rows.map(r => `${r.id} | ${r.titulo} | ${r.duration_s}s`);\n  message = `Clips pending (${rows.length}):\\n` + lines.join('\\n');\n}\nreturn [{ json: { message } }];"
      },
      "id": "clipes-format",
      "name": "Clipes: Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 220]
    },
