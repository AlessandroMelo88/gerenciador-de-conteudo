{
  "name": "06 — Resumo Diário 18h BRT",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger 18h BRT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS pending FROM generated_clips WHERE status='pending'",
        "options": {}
      },
      "id": "count-pending",
      "name": "Count Pending",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2,
      "position": [460, 300],
      "credentials": {
        "mySql": {
          "id": "mysql-canal-decortes",
          "name": "MySQL Canal de Cortes"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.pending }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        },
        "options": {}
      },
      "id": "if-tem-pending",
      "name": "Tem Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID_ALLOWED }}",
        "text": "={{ $json.pending }} clip(s) aguardando aprovação. Use /clipes para listar.",
        "additionalFields": {}
      },
      "id": "send-resumo",
      "name": "Enviar Resumo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 220],
      "credentials": {
        "telegramApi": {
          "id": "telegram-canal-decortes",
          "name": "Telegram Canal de Cortes"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger 18h BRT": {
      "main": [
        [{ "node": "Count Pending", "type": "main", "index": 0 }]
      ]
    },
    "Count Pending": {
      "main": [
        [{ "node": "Tem Pending?", "type": "main", "index": 0 }]
      ]
    },
    "Tem Pending?": {
      "main": [
        [{ "node": "Enviar Resumo", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "America/Sao_Paulo",
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "phase6-resumo-diario",
    "description": "Phase 6 Resumo Diário 18h BRT (Plan 06-07). Conta clips pending; envia mensagem Telegram apenas se > 0 (skip silencioso se 0)."
  }
}
