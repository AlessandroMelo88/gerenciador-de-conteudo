# ============================================================
# Canal de Cortes — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais
# NUNCA commitar .env
# ============================================================

# Compose local isolado — não usa portas, nomes de container ou volumes de outros projetos
COMPOSE_PROJECT_NAME=canaldecortes
APP_PORT=8088
APP_URL=http://localhost:8088

# MySQL local do projeto
MYSQL_DATABASE=clips_automation
MYSQL_USER=clips_user
MYSQL_ROOT_PASSWORD=

# Backup diário do MySQL — prefira apontar MYSQL_BACKUP_DIR para outro disco.
MYSQL_BACKUP_DIR=./backups/mysql
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# n8n — Gerar com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Anthropic Claude API
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq API — transcrição de áudio via Whisper online (gratuito)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=

# MySQL — senha para o usuário clips_user (você escolhe)
CLIPS_DB_PASSWORD=

# Controle seguro do worker no primeiro boot. Mantenha false até preencher as
# chaves de IA e concluir o OAuth do canal de destino.
PIPELINE_ENABLED=false

# OAuth do YouTube. O arquivo deve existir em ./youtube e é montado no worker.
YOUTUBE_CLIENT_SECRETS=/app/youtube/client_secret.json

# ============================================================
# Phase 6 — Controle Manual via Telegram + N8N
# ============================================================

# Modo de aprovação:
#   false (default) = 100% automático — publisher pega clipes 'pending' direto
#   true            = operador aprova via Telegram /aprovar antes de publicar
MANUAL_APPROVAL_REQUIRED=false

# Telegram bot (criar via @BotFather) — só usado se MANUAL_APPROVAL_REQUIRED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALLOWED=5760918317
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Tunnel (token vem do dashboard Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# n8n webhook público via Cloudflare Tunnel
N8N_WEBHOOK_URL=https://n8n.example.com.br
N8N_HOST=n8n.example.com.br

# Webhook interno (clip-processor → n8n) para notificações proativas
N8N_NOTIFY_URL=http://n8n:5678/webhook/notify

# TTL de clipes pending (worker APScheduler)
CLIP_PENDING_TTL_HOURS=48
CLIP_PENDING_WARN_HOURS=24

# ============================================================
# Phase 8 — Painel Laravel (Inertia + React + shadcn UI): ponte HTTP interna
# ============================================================

# Token compartilhado entre o painel Laravel (container php) e o sidecar
# HTTP interno do clip-processor (porta 8090, rede docker `internal`,
# SEM publicação no host). Gerar uma única vez no setup:
#   openssl rand -hex 32
# Colar o MESMO valor aqui E em canaldecortes/painel/.env
# (CLIP_PROCESSOR_INTERNAL_TOKEN=<hex>) — os dois lados precisam bater.
CLIP_PROCESSOR_INTERNAL_TOKEN=

# Janela de download e cota de publicação
DOWNLOAD_WINDOW_CURTO=6
DOWNLOAD_WINDOW_LONGO=4
MAX_UPLOADS_PER_DAY=2
MAX_LONGO_UPLOADS_PER_DAY=1
UPLOAD_WINDOW_BYPASS=false
YOUTUBE_PRIVACY_STATUS=private
