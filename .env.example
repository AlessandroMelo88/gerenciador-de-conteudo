# ============================================================
# Canal de Cortes — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais
# NUNCA commitar .env
# ============================================================

# Compose local isolado — não usa portas, nomes de container ou volumes de outros projetos
COMPOSE_PROJECT_NAME=canaldecortes
APP_PORT=8088
APP_URL=http://localhost:8088

# PostgreSQL local do projeto
POSTGRES_DB=clips_automation
POSTGRES_USER=clips_user

# Backup diário do PostgreSQL — prefira apontar POSTGRES_BACKUP_DIR para outro disco.
POSTGRES_BACKUP_DIR=./backups/postgres
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Provider de IA: Groq é o padrão. Outro provider só roda se AI_PROVIDER o ativar.
AI_PROVIDER=groq

# Anthropic Claude API — só usada com AI_PROVIDER=anthropic
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq API — transcrição de áudio via Whisper online (gratuito)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# ============================================================
# Banco de Dados (PostgreSQL 17 em produção na Oracle A1)
# ============================================================
DB_CONNECTION=pgsql
POSTGRES_DB=clips_automation
POSTGRES_USER=clips_user
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CLIPS_DB_PASSWORD=

# Controle seguro do worker no primeiro boot. Mantenha false até preencher as
# chaves de IA e concluir o OAuth do canal de destino.
PIPELINE_ENABLED=false
PIPELINE_LOCK_RECOVER_ON_BOOT=false

# OAuth do YouTube. O arquivo deve existir em ./youtube e é montado no worker.
YOUTUBE_CLIENT_SECRETS=/app/youtube/client_secret.json

# Shorts: antes de queimar a legenda, o worker checa por OCR se o vídeo fonte já
# vem com legenda gravada no quadro (evita duas legendas na tela). false desliga
# a checagem e volta a queimar sempre.
BURNED_SUBTITLE_DETECTION=true

# Qualidade do render FFmpeg (padrão qualidade máxima; modo economia opcional)
VIDEO_RENDER_MODE=quality
FFMPEG_PRESET=slow
FFMPEG_CRF=14
# Locks cobrem encodes lentos e impedem duas rodadas concorrentes.
PIPELINE_LOCK_TIMEOUT_SECONDS=7200
PUBLISH_LOCK_TIMEOUT_SECONDS=7200

# Workers do pipeline (um processo por etapa; os intervalos são em segundos).
# Poll, publicação e manutenção continuam singleton; download/IA/render ficam
# isolados para não bloquear as outras etapas.
WORKER_LOCK_TTL_SECONDS=7200
WORKER_INTERVAL_SECONDS=0

# Assets canônicos por canal e biblioteca musical (montados como /app/assets)
ASSETS_DIR=/app/assets

# ============================================================
# Telegram — controle manual opcional; o agendamento atual usa workers/Laravel
# ============================================================

# Modo de aprovação:
#   false (default) = 100% automático — publisher pega clipes 'pending' direto
#   true            = operador aprova via Telegram /aprovar antes de publicar
MANUAL_APPROVAL_REQUIRED=false

# Telegram bot (criar via @BotFather) — só usado se MANUAL_APPROVAL_REQUIRED=true.
# TELEGRAM_WEBHOOK_SECRET é obrigatório para aceitar atualizações do webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALLOWED=
TELEGRAM_WEBHOOK_SECRET=

# TTL de clipes pending (clip-maintenance)
CLIP_PENDING_TTL_HOURS=48
CLIP_PENDING_WARN_HOURS=24

# ============================================================
# Phase 8 — Painel Laravel (Inertia + React + shadcn UI): ponte HTTP interna
# ============================================================

# Token compartilhado entre o painel Laravel (container php) e o sidecar
# HTTP interno do clip-processor (porta 8090, rede docker `internal`,
# SEM publicação no host). Gerar uma única vez no setup:
#   openssl rand -hex 32
# Colar o MESMO valor aqui E em canaldecortes/painel/.env
# (CLIP_PROCESSOR_INTERNAL_TOKEN=<hex>) — os dois lados precisam bater.
CLIP_PROCESSOR_INTERNAL_TOKEN=

# Janela de download e cota de publicação
DOWNLOAD_WINDOW_CURTO=6
DOWNLOAD_WINDOW_LONGO=0
# Fallback legado. A validade efetiva é configurada por canal: 3 ou 1500 dias.
FRESHNESS_DAYS=1500
AUTO_INGEST_FORMAT=curto
# Um Short dura de 30 a 45s por padrão; aumente para testar cortes mais longos.
SHORTS_MAX_DURATION_SECONDS=45
# Vídeos longos em horários separados por 8h; Shorts nas janelas de pico.
LONG_UPLOAD_HOURS=6,14,22
SHORTS_PEAK_HOURS=12,20
MAX_UPLOADS_PER_DAY=6
MAX_LONGO_UPLOADS_PER_DAY=3
MAX_CURTO_UPLOADS_PER_DAY=3
ABSOLUTE_MAX_UPLOADS_PER_DAY=6
# Intervalo mínimo entre publicações do mesmo destino (minutos).
MIN_UPLOAD_INTERVAL_MINUTES=60
UPLOAD_WINDOW_BYPASS=false
YOUTUBE_PRIVACY_STATUS=public
# O vídeo sobe como privado, recebe a legenda oficial e só fica visível depois
# que o YouTube concluir o processamento HD.
YOUTUBE_WAIT_FOR_HD=true
YOUTUBE_PROCESSING_TIMEOUT_SECONDS=900
YOUTUBE_PROCESSING_POLL_SECONDS=10
