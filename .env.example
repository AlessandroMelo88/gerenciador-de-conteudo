# ============================================================
# Canal de Cortes — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais
# NUNCA commitar .env
# ============================================================

# n8n — Gerar com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Anthropic Claude API
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq API — transcrição de áudio via Whisper online (gratuito)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=

# MySQL — senha para o usuário clips_user (você escolhe)
CLIPS_DB_PASSWORD=

# MySQL root (já configurado no docker-compose existente)
MYSQL_ROOT_PASSWORD=rootpassword

# ============================================================
# Phase 6 — Controle Manual via Telegram + N8N
# ============================================================

# Telegram bot (criar via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALLOWED=5760918317
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Tunnel (token vem do dashboard Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# n8n webhook público via Cloudflare Tunnel
N8N_WEBHOOK_URL=https://n8n.example.com.br
N8N_HOST=n8n.example.com.br

# Webhook interno (clip-processor → n8n) para notificações proativas
N8N_NOTIFY_URL=http://n8n:5678/webhook/notify

# TTL de clipes pending (worker APScheduler)
CLIP_PENDING_TTL_HOURS=48
CLIP_PENDING_WARN_HOURS=24
