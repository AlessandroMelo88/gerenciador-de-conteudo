# ============================================================
# Segredos e credenciais — NUNCA commitar
# ============================================================
.env
.env.*
!.env.example
painel/.env
painel/.env.*
!painel/.env.example
*.pem
*.p12
auth.json

# YouTube OAuth (tokens e client secrets)
youtube/token*.json
youtube/client_secret*.json
youtube/*client_secret*.json
youtube/old_client_secret.json

# ============================================================
# Dados de runtime — gerados pelo pipeline (volume Docker)
# ============================================================
videos/*
!videos/.gitkeep
*.part
*.ytdl
*.temp.mp4

# Dumps e backups de banco — nunca no Git. Usar backups/mysql + scripts/*-mysql.sh
backups/*
!backups/mysql/
backups/mysql/*
!backups/mysql/.gitkeep
backup*.sql
*.sql.gz
*.sql.gz.sha256
*.dump

# Modelos Whisper (download local, muito pesados)
whisper/models/

# Dados persistentes do n8n (serviço desativado, mantido por histórico)
n8n/data/

# ============================================================
# Python (clip-processor)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml
clip-processor/build/
clip-processor/dist/

# ============================================================
# PHP / Laravel (painel) — complementa painel/.gitignore
# ============================================================
painel/vendor/
painel/.phpunit.result.cache
painel/.phpunit.cache/
painel/storage/logs/*.log
painel/storage/pail
painel/phpstan-baseline-local.neon

# ============================================================
# Node / frontend
# ============================================================
node_modules/
painel/public/build/
painel/public/hot
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ============================================================
# Logs e temporários
# ============================================================
*.log
*.tmp
*.bak
*.swp
*~
.cache/

# ============================================================
# Sistema operacional / IDE
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.cursor/
.codex/

# ============================================================
# Ferramentas
# ============================================================
# graphify: o grafo (graph.json, GRAPH_REPORT.md) é versionado; cache e custo não
graphify-out/cost.json
graphify-out/cache/
# Docker Compose local
docker-compose.override.yml
compose.override.yml
