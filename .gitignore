# ============================================================
# Segredos e credenciais — NUNCA commitar
# ============================================================
.env
.env.*
!.env.example
painel/.env
painel/.env.*
!painel/.env.example

# YouTube OAuth (tokens, cookies e client secrets)
youtube/token*.json
youtube/client_secret*.json
youtube/*client_secret*.json
youtube/old_client_secret.json
youtube/cookies.txt
cookies.txt

# Database Dumps / Backups
*.sql
*.sql.gz

# Chaves SSH / Certificados
*.key
*.pem


# ============================================================
# Dados de runtime — gerados pelo pipeline (volume Docker)
# ============================================================
videos/*
!videos/.gitkeep
*.part

# Modelos Whisper (download local, muito pesados)
whisper/models/

# Dados persistentes do n8n
n8n/data/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ============================================================
# Sistema operacional / IDE
# ============================================================
.DS_Store
Thumbs.db
# Config local do Claude fica de fora, menos as skills do projeto — todo agente
# e toda sessão precisa enxergar o fluxo de deploy.
.claude/*
!.claude/skills/
# Laravel / Frontend
painel/vendor/
painel/node_modules/
painel/storage/*.key
painel/public/hot
painel/public/storage

# graphify
graphify-out/cost.json
# Cache de AST: 13 MB e refeito de graça por `graphify update .` (sem custo de API).
# O cache SEMÂNTICO (graphify-out/cache/semantic/) continua versionado de propósito:
# refazer aquele custa chamada de API.
graphify-out/cache/ast/
# Snapshots datados do grafo: histórico de 5 MB por dia. O grafo atual
# (graph.json, GRAPH_REPORT.md, manifest.json) continua versionado.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Logs e estado do cron/launchd: mudam a cada execução e sujam o git status.
scripts/*.log
scripts/cron_status.json

# Material entregue por fora, não faz parte do projeto.
Claude outputs/

# Material de curso (privado, nunca no repositório público). Mora em
# painel/storage/app/private/conteudo-cursos — mesma árvore no Mac e na A1
# (/mnt/videos/conteudo-cursos), servida só por rota autenticada.
painel/public/conteudo-cursos/
painel/storage/app/private/conteudo-cursos/
.coverage
htmlcov/
