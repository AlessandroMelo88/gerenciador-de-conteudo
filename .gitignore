# ============================================================
# Segredos e credenciais — NUNCA commitar
# ============================================================
.env
.env.*
!.env.example
!.env.native.example
painel/.env
painel/.env.*
!painel/.env.example
*.pem
*.p12
auth.json

# YouTube OAuth (tokens, cookies e client secrets)
youtube/token*.json
youtube/client_secret*.json
youtube/*client_secret*.json
youtube/old_client_secret.json
youtube/cookies.txt
cookies.txt

# Database Dumps / Backups
*.sql
*.sql.gz

# Chaves SSH / Certificados
*.key
*.pem


# ============================================================
# Dados de runtime — gerados pelo pipeline (volume Docker)
# ============================================================
videos/*
!videos/.gitkeep
/var/videos/
/var/native-worker/
*.part
*.ytdl
*.temp.mp4

# Dumps e backups de banco — nunca no Git. Usar backups/postgres + scripts/*-postgres.sh
backups/*
!backups/postgres/
!backups/postgres/.gitkeep
backup*.sql
*.sql.gz
*.sql.gz.sha256
*.dump

# Modelos Whisper (download local, muito pesados)
whisper/models/

# Dados persistentes do n8n (serviço desativado, mantido por histórico)
n8n/data/

# ============================================================
# Python (clip-processor)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml
clip-processor/build/
clip-processor/dist/

# ============================================================
# PHP / Laravel (painel) — complementa painel/.gitignore
# ============================================================
painel/vendor/
painel/.phpunit.result.cache
painel/.phpunit.cache/
painel/storage/logs/*.log
painel/storage/pail
painel/phpstan-baseline-local.neon

# ============================================================
# Node / frontend
# ============================================================
node_modules/
painel/public/build/
painel/public/hot
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ============================================================
# Logs e temporários
# ============================================================
*.log
*.tmp
*.bak
*.swp
*~
.cache/

# ============================================================
# Sistema operacional / IDE
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
.codex/
# Config local do Claude fica de fora, menos as skills do projeto — todo agente
# e toda sessão precisa enxergar o fluxo de deploy.
.claude/*
!.claude/skills/

# Laravel / Frontend
painel/vendor/
painel/node_modules/
painel/storage/*.key
painel/public/hot
painel/public/storage

# ============================================================
# Ferramentas
# ============================================================
# graphify: o grafo (graph.json, GRAPH_REPORT.md) é versionado; cache e custo não
graphify-out/cost.json
graphify-out/cache/
# Docker Compose local
docker-compose.override.yml
compose.override.yml

# Material de curso (privado, nunca no repositório público). Mora em
# painel/storage/app/private/conteudo-cursos — mesma árvore no Mac e na A1
# (/mnt/videos/conteudo-cursos), servida só por rota autenticada.
painel/public/conteudo-cursos/
painel/storage/app/private/conteudo-cursos/
playwright-report/
test-results/
coverage/
