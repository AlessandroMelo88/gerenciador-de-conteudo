{"nodes": [{"id": "research_pitfalls_v2", "label": ".planning/research/PITFALLS.md", "file_type": "document", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_pitfalls_shared_quota_pool", "label": "Pitfall: Quota Cega \u2014 shared GCP project quota", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quota belongs to the GCP project not the OAuth credential/channel; multiple channels in one project share the 10,000 unit/day pool and can silently block all uploads."}, {"id": "research_pitfalls_oauth_testing_mode", "label": "Pitfall: OAuth App in Testing Mode Breaks Weekly", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unverified OAuth apps get 7-day refresh tokens for sensitive scopes; apps failing compliance audit silently upload as private."}, {"id": "research_pitfalls_wrong_channel_routing", "label": "Pitfall: Routing Clip to Wrong Channel Destroys Niche", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without niche/destination_channel_id columns, clips of different niches compete in the same publish queue and can be misrouted."}, {"id": "research_pitfalls_filament_enum_break", "label": "Pitfall: Filament Auto-Generated Resources Break on ENUM Columns", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "php artisan make:filament-resource --generate silently skips ENUM columns, generating free-text inputs that let operators write invalid state values, corrupting the pipeline state machine."}, {"id": "research_pitfalls_laravel_python_race_condition", "label": "Pitfall: Laravel Writes Conflict with Python Pipeline Mid-Transaction", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate processes writing the same MySQL rows with no distributed lock can flip clip status incorrectly; requires SELECT ... FOR UPDATE / lockForUpdate() and a clear state-transition ownership boundary."}, {"id": "research_pitfalls_telegram_duplicate_updates", "label": "Pitfall: Webhook Receives Duplicate Updates on Server Errors", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Telegram webhook delivery is at-least-once; non-2xx or timeout triggers retries, so idempotency via update_id tracking must be built in from day one."}, {"id": "research_pitfalls_n8n_parallel_bot", "label": "Pitfall: n8n Still Running Telegram Bot in Parallel After Migration", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If n8n's Telegram webhook isn't explicitly deregistered before Laravel's is registered, updates route to whichever is registered last, silently breaking the other."}, {"id": "research_pitfalls_content_id_watermark_ineffective", "label": "Pitfall: Content ID Claim Despite Watermark", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content ID fingerprints audio/visual content independently of any visual watermark; blacklist of high-risk source channels matters far more than watermarking."}, {"id": "research_pitfalls_blacklist_too_late", "label": "Pitfall: Blacklist Check Happens Too Late in the Pipeline", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checking blacklist only at publish time wastes download/transcription/AI compute; must be enforced at RSS ingestion, the earliest possible step."}, {"id": "research_pitfalls_filament_delete_orphans", "label": "Pitfall: Filament Delete Button Deletes MySQL Row Without Deleting Files", "file_type": "rationale", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filament's default delete only removes the Eloquent row; associated clip/thumbnail files remain on disk unless a model observer or dispatched job also deletes them."}], "edges": [{"source": "research_pitfalls_v2", "target": "research_pitfalls_shared_quota_pool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"source": "research_pitfalls_v2", "target": "research_pitfalls_oauth_testing_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"source": "research_pitfalls_v2", "target": "research_pitfalls_wrong_channel_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"source": "research_pitfalls_v2", "target": "research_pitfalls_filament_enum_break", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/