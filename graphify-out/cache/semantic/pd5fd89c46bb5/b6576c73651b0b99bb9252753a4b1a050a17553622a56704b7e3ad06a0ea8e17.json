{"nodes": [{"id": "08_01_summary", "label": "Phase 08 Plan 01 Summary: Bootstrap Laravel/Filament/Pest", "file_type": "document", "source_file": ".planning/phases/08-painel-laravel-filament/08-01-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "php83_rebuild_deviation", "label": "wordpress-php image rebuild PHP 8.2->8.3 (Rule 3 blocking fix)", "file_type": "rationale", "source_file": ".planning/phases/08-painel-laravel-filament/08-01-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O Dockerfile j\u00e1 declarava FROM php:8.3-fpm (coment\u00e1rio: alinhado ao Kelnab, composer exige ^8.3), mas a imagem em uso ainda rodava PHP 8.2.29 por falta de rebuild anterior. Laravel 13 exige PHP >=8.3, ent\u00e3o o rebuild foi tratado como corre\u00e7\u00e3o de drift (Rule 3), n\u00e3o como mudan\u00e7a arquitetural nova."}, {"id": "pest_init_vs_artisan_pest_install", "label": "vendor/bin/pest --init replaces nonexistent php artisan pest:install (Pest 4)", "file_type": "rationale", "source_file": ".planning/phases/08-painel-laravel-filament/08-01-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "php artisan pest:install n\u00e3o existe mais no Pest 4; o comando correto \u00e9 ./vendor/bin/pest --init, que produz o mesmo resultado (tests/Pest.php criado)."}], "edges": [{"source": "07_07_summary", "target": "08_01_plan", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".planning/phases/08-painel-laravel-filament/08-01-SUMMARY.md", "source_location": null, "weight": 1.0}, {"source": "08_01_plan", "target": "08_01_summary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/phases/08-painel-laravel-filament/08-01-SUMMARY.md", "source_location