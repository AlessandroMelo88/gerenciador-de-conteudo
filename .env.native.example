# Configuração para workers rodando direto no Linux/macOS, sem Docker.
# Copie este arquivo para .env, preencha as credenciais e configure os serviços.
DB_CONNECTION=pgsql
POSTGRES_DB=clips_automation
POSTGRES_USER=clips_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# O pipeline permanece pausado até credenciais e canais serem conferidos.
PIPELINE_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=

# Pastas relativas à raiz do projeto; o runner as converte para caminhos absolutos.
VIDEOS_DIR=var/videos
ASSETS_DIR=assets
BRANDING_DIR=branding
YOUTUBE_DIR=youtube
YOUTUBE_CLIENT_SECRETS=youtube/client_secret.json
YOUTUBE_COOKIES_FILE=youtube/cookies.txt

# Evento de publicação para atualizar o painel (ajuste URL e Host se o painel
# estiver remoto). Use o mesmo token configurado no painel.
LARAVEL_NOTIFY_URL=http://127.0.0.1:8088/internal/pipeline-event
LARAVEL_HOST_HEADER=localhost
CLIP_PROCESSOR_INTERNAL_TOKEN=

# Freshness é definido por canal no painel; este valor é só o fallback legado.
FRESHNESS_DAYS=1500
DOWNLOAD_WINDOW_PER_CHANNEL=10
# O poller RSS gera Shorts e tenta um longo quando há trecho contínuo elegível na transcrição.
SHORTS_MAX_DURATION_SECONDS=45
USE_YOUTUBE_AUTO_CAPTIONS=false
MEME_EFFECTS_CHANNELS=

# Três vídeos longos por canal em horários separados por 8h e Shorts em picos.
LONG_UPLOAD_HOURS=6,14,22
SHORTS_PEAK_HOURS=12,20
MAX_UPLOADS_PER_DAY=6
MAX_LONGO_UPLOADS_PER_DAY=3
MAX_CURTO_UPLOADS_PER_DAY=3
ABSOLUTE_MAX_UPLOADS_PER_DAY=6
MIN_UPLOAD_INTERVAL_MINUTES=60
UPLOAD_WINDOW_BYPASS=false

# Política para a publicação no YouTube.
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_WAIT_FOR_HD=true
YOUTUBE_PROCESSING_TIMEOUT_SECONDS=900
YOUTUBE_PROCESSING_POLL_SECONDS=10
